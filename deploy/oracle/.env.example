# Copy to deploy/oracle/.env (mode 0600; git-ignored). Names only: no secret belongs here.
# Passwords live in secrets/ (see secrets/README.md).

# Terraform outputs of infra/aws-f1 (see its README). No domain: the site is a cloudfront.net URL.
F1_SITE_URL=https://example.cloudfront.net
F1_WEB_BUCKET=
F1_CF_DISTRIBUTION=
# Host CloudFront uses to reach this VM over HTTP (Terraform origin_host) and the shared secret it
# sends as X-Origin-Secret (Terraform origin_secret). Caddy returns 403 without the secret.
F1_ORIGIN_HOST=84.8.217.209
F1_ORIGIN_SECRET=

# RCP's Caddy network (RCP's compose project is rcp-demo). Check: docker network ls
EDGE_NETWORK=rcp-demo_edge

# Private S3 data bucket (Terraform output data_bucket) for raw JSON, dumps and private assets, and its region / credentials profile.
F1_S3_BUCKET=
AWS_REGION=eu-west-1
AWS_PROFILE=default
# Set to 1 only for a first dry run before the bucket exists. Backups then stay on the VM.
F1_SKIP_OFFHOST=0

# Local backup retention in days.
F1_BACKUP_RETENTION_DAYS=7

# Weekly ingest source: api (default) or local (reads the raw files backup_openf1.py just fetched).
F1_INGEST_SOURCE=api

# Replay stack (kafka, replay-consumer, replay-producer). 1 = on (default); 0 = off, which also
# needs API_REPLAY_ENABLED=false. See README, memory options B and C.
F1_REPLAY=1
API_REPLAY_ENABLED=true

# API tuning.
API_RATE_PER_MIN=60
API_LIVE_MAX_STREAMS=20

# Replay: the session served live, and the speed multiplier of the producer.
REPLAY_SESSION_KEY=11361
REPLAY_SPEED=20

# Written by the scripts; do not edit by hand.
F1_UID=1000
F1_GID=1000
# API_TRUSTED_PROXIES is added by scripts/deploy.sh (the edge subnet).
