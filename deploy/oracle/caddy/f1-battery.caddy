# Site block for f1-battery, imported by RCP's Caddyfile (README.md, "Caddy").
# Caddy runs in RCP's compose project; it reaches these containers over RCP's `edge` network by
# their aliases: f1-api (Spring Boot, :8080) and f1-web (static files, :8080).
# {$F1_DOMAIN} comes from the environment of RCP's caddy service.
{$F1_DOMAIN:f1-battery.invalid} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	# The site is read-only.
	@write not method GET HEAD OPTIONS
	handle @write {
		respond "Method not allowed" 405
	}

	# Live replay is Server-Sent Events: no compression, no buffering.
	handle /api/live/* {
		reverse_proxy f1-api:8080 {
			flush_interval -1
			header_up -Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
			}
		}
	}

	handle /api/* {
		encode zstd gzip
		reverse_proxy f1-api:8080 {
			header_up -Authorization
			header_up -Cookie
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# Vite output: hashed files are immutable; index.html must be revalidated.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy f1-web:8080
	}

	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		reverse_proxy f1-web:8080
	}
}
