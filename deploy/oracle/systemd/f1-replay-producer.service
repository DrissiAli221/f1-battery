[Unit]
Description=f1-battery replay producer: re-emits REPLAY_SESSION_KEY onto Kafka at REPLAY_SPEED, looping
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/f1-battery/deploy/oracle
# One pass replays the whole session, then the process exits; Restart loops it so the live feed is always on.
ExecStart=/opt/f1-battery/deploy/oracle/scripts/dc.sh --profile replay --profile replay-run run --rm -T replay-producer
ExecStopPost=/opt/f1-battery/deploy/oracle/scripts/dc.sh --profile replay --profile replay-run rm -sf replay-producer
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
