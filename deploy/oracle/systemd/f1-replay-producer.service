[Unit]
Description=f1-battery on-demand replay controller: replays the sessions viewers have open, at REPLAY_SPEED (1 = real time)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/f1-battery/deploy/oracle
# The script polls the API's demand list and keeps up to REPLAY_MAX_SESSIONS producer+consumer pairs
# (containers f1-replay-<key>-producer / -consumer) running. Restart only covers the script itself dying.
# It removes its containers when it exits; the line below does the same if it was killed hard.
ExecStart=/opt/f1-battery/deploy/oracle/scripts/replay-controller.sh
ExecStopPost=/bin/sh -c 'ids=$(/usr/bin/docker ps -aq --filter name=^f1-replay-); [ -z "$ids" ] || /usr/bin/docker rm -f $ids'
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
