[Unit]
Description=f1-battery replay rotation: re-emits the recorded sessions onto Kafka at REPLAY_SPEED, one after another, forever
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/f1-battery/deploy/oracle
# The script loops over the sessions selected by REPLAY_SESSIONS (default: races), one producer run each.
# Restart only covers the script itself dying.
ExecStart=/opt/f1-battery/deploy/oracle/scripts/replay-rotate.sh
ExecStopPost=/opt/f1-battery/deploy/oracle/scripts/dc.sh --profile replay --profile replay-run rm -sf replay-producer
ExecStopPost=-/usr/bin/docker rm -f f1-replay-rotation-consumer
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
